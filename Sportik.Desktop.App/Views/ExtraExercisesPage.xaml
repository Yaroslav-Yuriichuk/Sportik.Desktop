<Page
    x:Class="Sportik.Desktop.App.Views.ExtraExercisesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:extraviewmodels="using:Sportik.Desktop.App.ViewModels.Extra"
    xmlns:converters="using:Sportik.Desktop.App.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <extraviewmodels:ExtraExercisesViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:DateTimeOffsetToStringConverter x:Name="DateTimeOffsetToStringConverter" />
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Extra exercises"
                   FontSize="32"
                   Margin="15 15 15 0"/>

        <Grid Grid.Row="1"
              Margin="15 15 15 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <ComboBox Grid.Row="0"
                      Margin="0 15 0 15"
                      MinWidth="300"
                      ItemsSource="{Binding ExercisesOptions}"
                      SelectedValue="{Binding SelectedExerciseOption, Mode=TwoWay}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Exercise.Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 0 0 15"
                        Visibility="Visible">

                <TextBlock Text="Date:"
                           Margin="0 0 15 0"
                           VerticalAlignment="Center" />

                <DatePicker Date="{Binding SelectedDate, Mode=TwoWay}" />

            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="15 0 0 15"
                        Visibility="Visible">

                <TextBlock Text="Repetitions:"
                           Margin="0 0 15 0"
                           VerticalAlignment="Center" />

                <ComboBox MinWidth="100"
                          ItemsSource="{Binding RepetitionsOptions}"
                          SelectedValue="{Binding SelectedRepetitionsOption, Mode=TwoWay}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IntValue}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

            </StackPanel>

            <Button Grid.Row="3"
                    Content="Add set"
                    HorizontalAlignment="Right"
                    Margin="0"
                    Command="{Binding AddSetCommand}" />

        </Grid>

        <ListView Grid.Row="2"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  Margin="15"
                  ItemsSource="{Binding Sets}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="extraviewmodels:SetViewModel">
                    <Grid Margin="10 0 0 0">
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="2*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <SymbolIcon Grid.Column="0"
                                    Symbol="World"
                                    Width="20"
                                    Height="20"
                                    Margin="0 0 10 0"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Exercise.Name}"
                                   FontSize="14"
                                   Margin="0 5 0 5" />

                        <TextBlock Grid.Column="2"
                                   FontSize="14"
                                   Margin="0 5 0 5">
                            <Run Text="Date: " />
                            <Run Text="{Binding Date, Converter={StaticResource DateTimeOffsetToStringConverter}, ConverterParameter='MMMM dd, yyyy'}" />
                        </TextBlock>

                        <TextBlock Grid.Column="3"
                                   FontSize="14"
                                   Margin="0 5 0 5">
                            <Run Text="Repetitions: " />
                            <Run Text="{Binding Repetitions}" />
                        </TextBlock>

                    </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>


        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="15 0 15 15">

            <Button Content="Save"
                    Margin="0 0 0 0"
                    MinWidth="140"
                    Command="{Binding SaveSetsCommand}" />

        </StackPanel>

    </Grid>
</Page>
