<Page
    x:Class="Sportik.Desktop.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingsviewmodels="using:Sportik.Desktop.App.ViewModels.Settings"
    xmlns:converters="using:Sportik.Desktop.App.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <settingsviewmodels:SettingsViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:TimeSpanToLongHoursMinutesStringConverter x:Name="TimeSpanToStringConverter" />
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="32"
                   Margin="15 15 15 0"/>

        <ListView Grid.Row="1"
          IsItemClickEnabled="True"
          SelectionMode="None"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          Margin="15"
          ItemsSource="{Binding ExerciseSettings}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="settingsviewmodels:ExerciseSettingsViewModel">
                    <StackPanel HorizontalAlignment="Stretch">

                        <Grid Margin="15 15 15 15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="77" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Grid.Column="0"
                                Symbol="World"
                                Width="27"
                                Height="27" />

                            <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="20"
                               Margin="15 0 0 0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="15 0 15 15"
                                    Visibility="Visible">

                            <TextBlock Text="Target repetitions:"
                                       Margin="0 0 15 0"
                                       VerticalAlignment="Center" />

                            <ComboBox MinWidth="100"
                                      ItemsSource="{Binding TargetRepetitionsOptions}"
                                      SelectedValue="{Binding SelectedTargetRepetitionsOption, Mode=TwoWay}">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IntValue}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="15 0 15 15"
                            Visibility="Visible">

                            <TextBlock Text="Time between sets:"
                                       Margin="0 0 15 0"
                                       VerticalAlignment="Center" />

                            <ComboBox MinWidth="100"
                                      ItemsSource="{Binding TimeBetweenSetsOptions}"
                                      SelectedItem="{Binding SelectedTimeBetweenSetsOption, Mode=TwoWay}">
                                
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeSpanValue, Converter={StaticResource TimeSpanToStringConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="15 0 15 15"
                                    Visibility="Visible">

                            <TextBlock Text="Execution time:"
                                       Margin="0 0 15 0"
                                       VerticalAlignment="Center" />

                            <ComboBox MinWidth="100"
                                      ItemsSource="{Binding ExecutionTimeOptions}"
                                      SelectedValue="{Binding SelectedExecutionTimeOption, Mode=TwoWay}">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeSpanValue, Converter={StaticResource TimeSpanToStringConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                            </ComboBox>

                        </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</Page>
