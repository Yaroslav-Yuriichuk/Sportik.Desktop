<Page
    x:Class="Sportik.Desktop.UI.Views.ExercisesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:exercises="using:Sportik.Desktop.UI.ViewModels.Exercises"
    xmlns:converters="using:Sportik.Desktop.UI.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <exercises:ExercisesViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:TimeSpanToLongHoursMinutesSecondsStringConverter x:Name="TimeSpanToLongHoursMinutesSecondsStringConverter" />
        <converters:EnumTargetValueToVisibilityConverter x:Name="EnumTargetValueToVisibilityConverter" />
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Exercises"
                   FontSize="32"
                   Margin="15 15 15 0"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="15 15 15 0">

            <TextBlock Text="Mode:"
                       Margin="0 0 15 0"
                       VerticalAlignment="Center" />

            <ComboBox MinWidth="140"
                      Margin="0"
                      ItemsSource="{Binding ReminderModeOptions}"
                      SelectedValue="{Binding SelectedReminderModeOption, Mode=TwoWay}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

        </StackPanel>

        <ListView Grid.Row="2"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Margin="15"
                  ItemsSource="{Binding ParallelExercises}"
                  Visibility="{Binding ReminderMode, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Parallel}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="exercises:ParallelExerciseViewModel">
                    <StackPanel HorizontalAlignment="Stretch">

                        <Grid Margin="15 15 15 15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="77" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Grid.Column="0"
                                        Symbol="World"
                                        Width="27"
                                        Height="27" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="20"
                                       Margin="15 0 0 0" />

                            <ToggleSwitch Grid.Column="3"
                                          IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="15 0 15 15"
                                    Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=WaitingBeforeForceExecution}">

                            <TextBlock Margin="0 0 10 0"
                                       VerticalAlignment="Center">
                                <Run Text="Next reminder in"></Run>
                                <Run Text="{Binding ReminderTime, Converter={StaticResource TimeSpanToLongHoursMinutesSecondsStringConverter}}"></Run>
                            </TextBlock>

                            <SymbolIcon Symbol="Clock" />

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="15 0 15 15"
                                    Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=WaitingWithForceExecution}">

                            <TextBlock Margin="0 0 10 0"
                                       VerticalAlignment="Center">
                                <Run Text="Next reminder in"></Run>
                                <Run Text="{Binding ReminderTime, Converter={StaticResource TimeSpanToLongHoursMinutesSecondsStringConverter}}"></Run>
                            </TextBlock>

                            <SymbolIcon Symbol="Clock"
                                        Margin="0 0 10 0" />

                            <Button Content="Start executing"
                                    MinWidth="140"
                                    Command="{Binding ExecuteCommand}"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="15 0 15 15"
                                    Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Executing}">

                            <TextBlock Margin="0 0 10 0"
                                       VerticalAlignment="Center">
                                <Run Text="Only"></Run>
                                <Run Text="{Binding ExecutionTime, Converter={StaticResource TimeSpanToLongHoursMinutesSecondsStringConverter}}"></Run>
                                <Run Text="left to complete"></Run>
                            </TextBlock>

                            <SymbolIcon Symbol="Clock"
                                        Margin="0 0 10 0"/>

                            <Button Content="Mark as completed"
                                    MinWidth="140"
                                    Command="{Binding CompleteCommand}"/>

                        </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <ListView Grid.Row="2"
          IsItemClickEnabled="True"
          SelectionMode="None"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          Margin="15"
          ItemsSource="{Binding SequentialExercises}"
          Visibility="{Binding ReminderMode, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Sequential}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="exercises:SequentialExerciseViewModel">
                    <StackPanel HorizontalAlignment="Stretch">

                        <Grid Margin="15 15 15 15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="77" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Grid.Column="0"
                                Symbol="World"
                                Width="27"
                                Height="27" />

                            <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="20"
                               Margin="15 0 0 0" />

                            <ToggleSwitch Grid.Column="3"
                                  IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="15 0 15 15"
                            Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=WaitingBeforeForceExecution}">

                            <TextBlock Margin="0 0 10 0"
                               VerticalAlignment="Center">
                                <Run Text="Next reminder in"></Run>
                                <Run Text="{Binding ReminderTime, Converter={StaticResource TimeSpanToLongHoursMinutesSecondsStringConverter}}"></Run>
                            </TextBlock>

                            <SymbolIcon Symbol="Clock" />

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="15 0 15 15"
                                    Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=WaitingWithForceExecution}">

                            <TextBlock Margin="0 0 10 0"
                                       VerticalAlignment="Center">
                                <Run Text="Next reminder in"></Run>
                                <Run Text="{Binding ReminderTime, Converter={StaticResource TimeSpanToLongHoursMinutesSecondsStringConverter}}"></Run>
                            </TextBlock>

                            <SymbolIcon Symbol="Clock"
                                        Margin="0 0 10 0" />

                            <Button Content="Start executing"
                                    MinWidth="140"
                                    Command="{Binding ExecuteCommand}"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="15 0 15 15"
                            Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Executing}">

                            <TextBlock Margin="0 0 10 0"
                               VerticalAlignment="Center">
                        <Run Text="Only"></Run>
                        <Run Text="{Binding ExecutionTime, Converter={StaticResource TimeSpanToLongHoursMinutesSecondsStringConverter}}"></Run>
                        <Run Text="left to complete"></Run>
                            </TextBlock>

                            <SymbolIcon Symbol="Clock"
                                Margin="0 0 10 0"/>

                            <Button Content="Mark as completed"
                                    MinWidth="140"
                                    Command="{Binding CompleteCommand}"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="15 0 15 15"
                                    Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Queued}">

                            <TextBlock Margin="0 0 10 0"
                                       VerticalAlignment="Center">
                                <Run Text="Queued"></Run>
                            </TextBlock>

                            <SymbolIcon Symbol="Clock"
                                        Margin="0 0 10 0" />

                            <Button Content="Switch"
                                    MinWidth="140"
                                    Command="{Binding SwitchCommand}"/>

                        </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="15 0 15 15">

            <Button Content="Pause"
                    Margin="0 0 15 0"
                    MinWidth="140"
                    Command="{Binding PauseCommand}" />

            <Button Content="Resume"
                    Margin="0"
                    MinWidth="140"
                    Command="{Binding ResumeCommand}" />

        </StackPanel>

    </Grid>
</Page>
