<Page
    x:Class="Sportik.Desktop.UI.Views.Internal.ExerciseStatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactivity"
    xmlns:statistics="using:Sportik.Desktop.UI.ViewModels.Statistics"
    xmlns:converters="using:Sportik.Desktop.UI.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <statistics:StatisticsViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:BoolToInvertedVisibilityConverter x:Name="BoolToInvertedVisibilityConverter" />
        <converters:DateTimeToStringConverter x:Name="DateTimeToStringConverter" />
        <converters:BoolToVisibilityConverter x:Name="BoolToVisibilityConverter" />
        <converters:EnumTargetValueToVisibilityConverter x:Name="EnumTargetValueToVisibilityConverter" />
        <converters:DateTimeToWeekConverter x:Name="DateTimeToWeekConverter" />
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Exercise Statistics"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Margin="15 15 15 0"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="15 15 15 0">

            <TextBlock Text="Group by:"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0 0 15 0"
                       VerticalAlignment="Center" />

            <ComboBox MinWidth="140"
                      Margin="0"
                      ItemsSource="{Binding GroupingOptions}"
                      SelectedValue="{Binding SelectedGroupingOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <ListView Grid.Row="2"
                  Margin="15 15 15 0"
                  IsItemClickEnabled="False"
                  SelectionMode="None"
                  ItemsSource="{Binding WeekStatistics}"
                  Visibility="{Binding SelectedGroupingOption.Grouping, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Week}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="statistics:WeekStatisticsViewModel">
                    <StackPanel>

                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 12">
                            <Run Text="{Binding FirstWeekDayDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='MMMM dd, yyyy'}" />
                            <Run Text="-" />
                            <Run Text="{Binding LastWeekDayDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='MMMM dd, yyyy'}" />
                        </TextBlock>

                        <ListView ItemsSource="{Binding DayStatistics}"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Grid Background="Transparent">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="CardBorder.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                    <Setter Target="CardBorder.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                                    <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                    <Border x:Name="CardBorder"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8" />

                                                    <ContentPresenter x:Name="ContentPresenter"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Margin="{TemplateBinding Padding}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="statistics:DayStatisticsViewModel">
                                    <StackPanel HorizontalAlignment="Stretch">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="15 15 15 15"
                                                    Background="Transparent">

                                            <interactivity:Interaction.Behaviors>
                                                <core:EventTriggerBehavior EventName="Tapped">
                                                    <core:InvokeCommandAction Command="{Binding ToggleCollapsedCommand}" />
                                                </core:EventTriggerBehavior>
                                            </interactivity:Interaction.Behaviors>

                                            <SymbolIcon Symbol="Accept"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Width="20"
                                                        Height="20" />

                                            <TextBlock Text="{Binding Date, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=dddd}"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="15 0 0 0" />

                                        </StackPanel>

                                        <ListView IsItemClickEnabled="False"
                                                  SelectionMode="None"
                                                  ItemsSource="{Binding ExerciseStatistics}"
                                                  Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToInvertedVisibilityConverter}}">

                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="statistics:ExerciseStatisticsViewModel">
                                                    <Grid Margin="50 0 15 15">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"></ColumnDefinition>
                                                            <ColumnDefinition Width="2*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>

                                                        <SymbolIcon Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    Symbol="World"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Margin="0 0 10 0" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0 5 0 5" />

                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="14"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0 5 0 5">
                                                            <Run Text="Sets:" />
                                                            <Run Text="{Binding Sets}" FontWeight="SemiBold" />
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="3"
                                                                   FontSize="14"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0 5 0 5">
                                                            <Run Text="Repetitions:" />
                                                            <Run Text="{Binding Repetitions}" FontWeight="SemiBold" />
                                                        </TextBlock>

                                                    </Grid>

                                                </DataTemplate>
                                            </ListView.ItemTemplate>

                                        </ListView>

                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView Grid.Row="2"
                  Margin="15 15 15 0"
                  IsItemClickEnabled="False"
                  SelectionMode="None"
                  ItemsSource="{Binding MonthStatistics}"
                  Visibility="{Binding SelectedGroupingOption.Grouping, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Month}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="statistics:MonthStatisticsViewModel">
                    <StackPanel>

                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 12">
                            <Run Text="{Binding FirstMonthDayDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='MMMM dd, yyyy'}" />
                            <Run Text="-" />
                            <Run Text="{Binding LastMonthDayDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='MMMM dd, yyyy'}" />
                        </TextBlock>

                        <ListView ItemsSource="{Binding WeekStatistics}"
                                  IsItemClickEnabled="False"
                                  SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Grid Background="Transparent">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="CardBorder.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                    <Setter Target="CardBorder.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                                    <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                    <Border x:Name="CardBorder"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8" />

                                                    <ContentPresenter x:Name="ContentPresenter"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Margin="{TemplateBinding Padding}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="statistics:WeekStatisticsViewModel">
                                    <StackPanel HorizontalAlignment="Stretch">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="15 15 15 15"
                                                    Background="Transparent">

                                            <interactivity:Interaction.Behaviors>
                                                <core:EventTriggerBehavior EventName="Tapped">
                                                    <core:InvokeCommandAction Command="{Binding ToggleCollapsedCommand}" />
                                                </core:EventTriggerBehavior>
                                            </interactivity:Interaction.Behaviors>

                                            <SymbolIcon Symbol="Accept"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Width="20"
                                                        Height="20" />

                                            <TextBlock FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="15 0 0 0">
                                                <Run Text="Week" />
                                                <Run Text="{Binding FirstWeekDayDate, Converter={StaticResource DateTimeToWeekConverter}}" />
                                            </TextBlock>

                                        </StackPanel>

                                        <ListView IsItemClickEnabled="False"
                                                  SelectionMode="None"
                                                  ItemsSource="{Binding ExerciseStatistics}"
                                                  Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToInvertedVisibilityConverter}}">

                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="statistics:ExerciseStatisticsViewModel">
                                                    <Grid Margin="50 0 15 15">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"></ColumnDefinition>
                                                            <ColumnDefinition Width="2*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>

                                                        <SymbolIcon Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    Symbol="World"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Margin="0 0 10 0" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0 5 0 5" />

                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="14"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0 5 0 5">
                                                            <Run Text="Sets:" />
                                                            <Run Text="{Binding Sets}" FontWeight="SemiBold" />
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="3"
                                                                   FontSize="14"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0 5 0 5">
                                                            <Run Text="Repetitions:" />
                                                            <Run Text="{Binding Repetitions}" FontWeight="SemiBold" />
                                                        </TextBlock>

                                                    </Grid>

                                                </DataTemplate>
                                            </ListView.ItemTemplate>

                                        </ListView>

                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView Grid.Row="2"
                  Margin="15 15 15 0"
                  IsItemClickEnabled="False"
                  SelectionMode="None"
                  ItemsSource="{Binding YearStatistics}"
                  Visibility="{Binding SelectedGroupingOption.Grouping, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Year}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="statistics:YearStatisticsViewModel">
                    <StackPanel>

                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 12">
                            <Run Text="Year" />
                            <Run Text="{Binding FirstYearDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='yyyy'}" />
                        </TextBlock>

                        <ListView ItemsSource="{Binding MonthStatistics}"
                                  IsItemClickEnabled="False"
                                  SelectionMode="None">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Grid Background="Transparent">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="CardBorder.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                    <Setter Target="CardBorder.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                                    <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                    <Border x:Name="CardBorder"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8" />

                                                    <ContentPresenter x:Name="ContentPresenter"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Margin="{TemplateBinding Padding}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="statistics:MonthStatisticsViewModel">
                                    <StackPanel HorizontalAlignment="Stretch">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="15 15 15 15"
                                                    Background="Transparent">

                                            <interactivity:Interaction.Behaviors>
                                                <core:EventTriggerBehavior EventName="Tapped">
                                                    <core:InvokeCommandAction Command="{Binding ToggleCollapsedCommand}" />
                                                </core:EventTriggerBehavior>
                                            </interactivity:Interaction.Behaviors>

                                            <SymbolIcon Symbol="Accept"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Width="20"
                                                        Height="20" />

                                            <TextBlock Text="{Binding FirstMonthDayDate, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='MMMM'}"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="15 0 0 0" />

                                        </StackPanel>

                                        <ListView IsItemClickEnabled="False"
                                                  SelectionMode="None"
                                                  ItemsSource="{Binding ExerciseStatistics}"
                                                  Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToInvertedVisibilityConverter}}">

                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="statistics:ExerciseStatisticsViewModel">
                                                    <Grid Margin="50 0 15 15">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"></ColumnDefinition>
                                                            <ColumnDefinition Width="2*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>

                                                        <SymbolIcon Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    Symbol="World"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Margin="0 0 10 0" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0 5 0 5" />

                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="14"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0 5 0 5">
                                                            <Run Text="Sets:" />
                                                            <Run Text="{Binding Sets}" FontWeight="SemiBold" />
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="3"
                                                                   FontSize="14"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0 5 0 5">
                                                            <Run Text="Repetitions:" />
                                                            <Run Text="{Binding Repetitions}" FontWeight="SemiBold" />
                                                        </TextBlock>

                                                    </Grid>

                                                </DataTemplate>
                                            </ListView.ItemTemplate>

                                        </ListView>

                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="15 15 15 15">

            <Button Content="Import"
                    Margin="0 0 15 0"
                    MinWidth="140"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{Binding ShowImportCommand}" />

            <Button Content="Export"
                    Margin="0 0 0 0"
                    MinWidth="140"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{Binding ShowExportCommand}" />

        </StackPanel>

        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              Background="#80000000"
              DataContext="{Binding Import}"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">

            <Border Width="420"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Import data"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0 0 0 15" />

                    <TextBlock Text="Scope"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0 0 0 5" />

                    <ComboBox HorizontalAlignment="Stretch"
                              Margin="0 0 0 15"
                              ItemsSource="{Binding ScopeOptions}"
                              SelectedValue="{Binding SelectedScopeOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Google Sheet Url or Id"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0 0 0 5" />

                    <TextBox Margin="0 0 0 15"
                             PlaceholderText="Enter Google Sheet Url or Id"
                             Text="{Binding GoogleSheetUrlOrId, Mode=TwoWay}" />

                    <TextBlock Text="Exercises sheet name"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0 0 0 5"
                               Visibility="{Binding Scope, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter='Exercises,ExercisesAndSets'}" />

                    <TextBox Margin="0 0 0 15"
                             PlaceholderText="Enter exercises sheet name"
                             Text="{Binding ExercisesSheetName, Mode=TwoWay}"
                             Visibility="{Binding Scope, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter='Exercises,ExercisesAndSets'}" />

                    <TextBlock Text="Sets sheet name"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0 0 0 5"
                               Visibility="{Binding Scope, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter='Sets,ExercisesAndSets'}" />

                    <TextBox Margin="0 0 0 15"
                             PlaceholderText="Enter sets sheet name"
                             Text="{Binding SetsSheetName, Mode=TwoWay}"
                             Visibility="{Binding Scope, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter='Sets,ExercisesAndSets'}" />

                    <CheckBox Content="Validate duplicates"
                              Margin="0 0 0 15"
                              IsChecked="{Binding ValidateDuplicates, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Close"
                                MinWidth="100"
                                Margin="0 0 10 0"
                                Command="{Binding CloseCommand}" />

                        <Button Content="Import"
                                MinWidth="120"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{Binding ImportCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              Background="#80000000"
              DataContext="{Binding Export}"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">

            <Border Width="420"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Export data"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0 0 0 15" />

                    <TextBlock Text="Scope"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0 0 0 5" />

                    <ComboBox HorizontalAlignment="Stretch"
                              Margin="0 0 0 15"
                              ItemsSource="{Binding ScopeOptions}"
                              SelectedValue="{Binding SelectedScopeOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Google Sheet Url or Id"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0 0 0 5" />

                    <TextBox Margin="0 0 0 15"
                             PlaceholderText="Enter Google Sheet Url or Id"
                             Text="{Binding GoogleSheetUrlOrId, Mode=TwoWay}" />

                    <TextBlock Text="Exercises sheet name"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0 0 0 5"
                               Visibility="{Binding Scope, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter='Exercises,ExercisesAndSets'}" />

                    <TextBox Margin="0 0 0 15"
                             PlaceholderText="Enter exercises sheet name"
                             Text="{Binding ExercisesSheetName, Mode=TwoWay}"
                             Visibility="{Binding Scope, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter='Exercises,ExercisesAndSets'}" />

                    <TextBlock Text="Sets sheet name"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0 0 0 5"
                               Visibility="{Binding Scope, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter='Sets,ExercisesAndSets'}" />

                    <TextBox Margin="0 0 0 15"
                             PlaceholderText="Enter sets sheet name"
                             Text="{Binding SetsSheetName, Mode=TwoWay}"
                             Visibility="{Binding Scope, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter='Sets,ExercisesAndSets'}" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Close"
                                MinWidth="100"
                                Margin="0 0 10 0"
                                Command="{Binding CloseCommand}" />

                        <Button Content="Export"
                                MinWidth="120"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{Binding ExportCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
