<Page
    x:Class="Sportik.Desktop.UI.Views.Internal.TrainingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:training="using:Sportik.Desktop.UI.ViewModels.Training"
    xmlns:converters="using:Sportik.Desktop.UI.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <training:TrainingViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:BoolToInvertedVisibilityConverter x:Name="BoolToInvertedVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Name="BoolToVisibilityConverter" />
        <converters:EnumTargetValueToVisibilityConverter x:Name="EnumTargetValueToVisibilityConverter" />
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Training"
                   FontSize="32"
                   Margin="15 15 15 0"/>

        <Grid Grid.Row="1"
              Visibility="{Binding IsTrainingRunning, Converter={StaticResource BoolToInvertedVisibilityConverter}}">

            <Grid DataContext="{Binding TrainingSetupViewModel}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="15 15 15 0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Row="0"
                              Margin="0 15 0 15"
                              MinWidth="300"
                              ItemsSource="{Binding ExercisesOptions}"
                              SelectedValue="{Binding SelectedExerciseOption, Mode=TwoWay}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Exercise.Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="15 0 0 15"
                                Visibility="Visible">

                        <TextBlock Text="Repetitions:"
                                   Margin="0 0 15 0"
                                   VerticalAlignment="Center" />

                        <ComboBox MinWidth="100"
                                  ItemsSource="{Binding RepetitionsOptions}"
                                  SelectedValue="{Binding SelectedRepetitionsOption, Mode=TwoWay}">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IntValue}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>

                    </StackPanel>

                    <Button Grid.Row="4"
                            Content="Add set"
                            HorizontalAlignment="Right"
                            Margin="0"
                            Command="{Binding AddSetCommand}" />

                </Grid>

                <ListView Grid.Row="1"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          Margin="15"
                          ItemsSource="{Binding Sets}">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="training:SetupSetViewModel">
                            <Grid Margin="10 0 0 0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <SymbolIcon Grid.Column="0"
                                            Symbol="World"
                                            Width="20"
                                            Height="20"
                                            Margin="0 0 10 0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Exercise.Name}"
                                           FontSize="14"
                                           Margin="0 5 0 5" />

                                <TextBlock Grid.Column="2"
                                           FontSize="14"
                                           Margin="0 5 5 5">
                                    <Run Text="Repetitions: " />
                                    <Run Text="{Binding Repetitions}" />
                                </TextBlock>

                            </Grid>

                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="15 0 15 15">

                    <Button Content="Start"
                            Margin="0 0 0 0"
                            MinWidth="140"
                            Command="{Binding StartTrainingCommand}" />

                </StackPanel>

            </Grid>

        </Grid>

        <Grid Grid.Row="1"
              Visibility="{Binding IsTrainingRunning, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid DataContext="{Binding TrainingExecutionViewModel}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <ListView Grid.Row="0"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Margin="15"
                      ItemsSource="{Binding Sets}">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="training:ExecutionSetViewModel">
                            <StackPanel HorizontalAlignment="Stretch">

                                <Grid Margin="15 15 15 15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <SymbolIcon Grid.Column="0"
                                                Symbol="World"
                                                Width="27"
                                                Height="27" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ExerciseName}"
                                               FontSize="20"
                                               Margin="15 0 0 0" />

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Completed}">

                                        <TextBlock Margin="0 0 10 0"
                                                   Text="Completed"
                                                   VerticalAlignment="Center">
                                        </TextBlock>

                                        <SymbolIcon Symbol="Accept" />

                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Executing}"
                                               VerticalAlignment="Center">
                                        <Run Text="Repetitions: " />
                                        <Run Text="{Binding Repetitions}" />
                                    </TextBlock>

                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="15 0 15 15"
                                            Visibility="{Binding State, Converter={StaticResource EnumTargetValueToVisibilityConverter}, ConverterParameter=Executing}">

                                    <Button Content="Mark as completed"
                                            MinWidth="140"
                                            Command="{Binding CompleteCommand}"/>

                                </StackPanel>

                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="15 0 15 15">

                    <Button Content="Cancel"
                            Margin="0 0 0 0"
                            MinWidth="140"
                            Command="{Binding CancelTrainingCommand}" />

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>
</Page>
