<Page
    x:Class="Sportik.Desktop.UI.Views.Main.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:login="using:Sportik.Desktop.UI.ViewModels.Login"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <login:LoginViewModel />
    </Page.DataContext>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="400"
                Padding="40"
                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Spacing="16">
                <TextBlock Text="Welcome Back"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4" />

                <TextBlock Text="Log in to continue to Sportik Desktop"
                           FontSize="14"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />

                <TextBox PlaceholderText="Email"
                         Text="{Binding Email, Mode=TwoWay}"
                         Padding="12,10"
                         FontSize="14" />

                <PasswordBox PlaceholderText="Password"
                             Password="{Binding Password, Mode=TwoWay}"
                             Padding="12,10"
                             FontSize="14" />

                <Button Content="Log in"
                        HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}"
                        MinHeight="40"
                        Margin="0,16,0,0"
                        Command="{Binding LoginCommand}" />

                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="or" Margin="16,0" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="13" />
                    <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" VerticalAlignment="Center" />
                </Grid>

                <Button Content="Sign up"
                        HorizontalAlignment="Stretch"
                        MinHeight="40"
                        Background="Transparent"
                        Command="{Binding RegisterCommand}" />

                <HyperlinkButton Content="Continue in offline mode"
                                 HorizontalAlignment="Center"
                                 Margin="0,8,0,0"
                                 Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                 Command="{Binding UseOfflineModeCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
