<Page
    x:Class="Sportik.UWP.Views.ExercisesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:exercisesviewmodels="using:Sportik.UWP.ViewModels.Exercises"
    xmlns:converters="using:Sportik.UWP.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <exercisesviewmodels:ExercisesViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:TimeSpanToLongHoursMinutesSecondsStringConverter x:Name="TimeSpanToLongHoursMinutesSecondsStringConverter" />
        <converters:BoolToVisibilityConverter x:Name="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Exercises"
                   FontSize="32"
                   Margin="15 15 15 0"/>

        <ListView Grid.Row="1"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Margin="15"
                  ItemsSource="{Binding Exercises}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="exercisesviewmodels:ExerciseViewModel">
                    <StackPanel HorizontalAlignment="Stretch">

                        <Grid Margin="15 15 15 15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="77" />
                            </Grid.ColumnDefinitions>

                            <SymbolIcon Grid.Column="0"
                                        Symbol="World"
                                        Width="27"
                                        Height="27" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="20"
                                       Margin="15 0 0 0" />

                            <ToggleSwitch Grid.Column="3"
                                          IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="15 0 15 15"
                                    Visibility="{Binding IsInWaitingState, Converter={StaticResource BoolToVisibilityConverter}}">

                            <TextBlock Margin="0 0 10 0"
                                       VerticalAlignment="Center">
                                <Run Text="Next reminder in"></Run>
                                <Run Text="{Binding ReminderTime, Converter={StaticResource TimeSpanToLongHoursMinutesSecondsStringConverter}}"></Run>
                            </TextBlock>

                            <SymbolIcon Symbol="Clock" />

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="15 0 15 15"
                                    Visibility="{Binding IsInExecutingState, Converter={StaticResource BoolToVisibilityConverter}}">

                            <TextBlock Margin="0 0 10 0"
                                       VerticalAlignment="Center">
                                <Run Text="Only"></Run>
                                <Run Text="{Binding ExecutionTime, Converter={StaticResource TimeSpanToLongHoursMinutesSecondsStringConverter}}"></Run>
                                <Run Text="left to complete"></Run>
                            </TextBlock>

                            <SymbolIcon Symbol="Clock"
                                        Margin="0 0 10 0"/>

                            <Button Content="Mark as completed"
                                    Command="{Binding CompleteCommand}"/>

                        </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</Page>
