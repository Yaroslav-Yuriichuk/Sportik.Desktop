<Page
    x:Class="Sportik.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:statisticssviewmodels="using:Sportik.ViewModels.Statistics"
    xmlns:converters="using:Sportik.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <statisticssviewmodels:StatisticsViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:DateTimeToDayNameConverter x:Name="DateTimeToDayNameConverter" />
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Statistics"
                   FontSize="32"
                   Margin="15 15 15 0"/>

        <ListView Grid.Row="1"
                  Margin="15"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ItemsSource="{Binding WeekStatistics}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="statisticssviewmodels:WeekStatisticsViewModel">
                    <StackPanel>

                        <TextBlock Text="Week"
                                   FontSize="20"
                                   Margin="15 15 15 15"/>

                        <ListView ItemsSource="{Binding DayStatistics}">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="statisticssviewmodels:DayStatisticsViewModel">
                                    <StackPanel HorizontalAlignment="Stretch">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left"
                                                    Margin="15 10 10 10">

                                            <SymbolIcon Symbol="Accept"
                                                        Width="20"
                                                        Height="20" />

                                            <TextBlock Text="{Binding Date, Converter={StaticResource DateTimeToDayNameConverter}}"
                                                       FontSize="14"
                                                       Margin="10 0 0 0"/>

                                        </StackPanel>

                                        <ListView IsItemClickEnabled="False"
                                                  SelectionMode="None"
                                                  ItemsSource="{Binding ExerciseStatistics}">

                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="statisticssviewmodels:ExerciseStatisticsViewModel">
                                                    <Grid Margin="45 0 0 0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>

                                                        <SymbolIcon Grid.Column="0"
                                                                    Symbol="Save"
                                                                    Width="20"
                                                                    Height="20" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   Margin="10 5 10 5" />

                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="14"
                                                                   Margin="10 5 10 5">
                                                            <Run Text="Sets: " />
                                                            <Run Text="{Binding Sets}" />
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="3"
                                                                   FontSize="14"
                                                                   Margin="10 5 10 5">
                                                            <Run Text="Repetitions: " />
                                                            <Run Text="{Binding Repetitions}" />
                                                        </TextBlock>

                                                    </Grid>

                                                </DataTemplate>
                                            </ListView.ItemTemplate>

                                        </ListView>

                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</Page>
